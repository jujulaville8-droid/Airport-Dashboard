# ============================================================================
# The Tailor's Daughter — Environment Variables
# ============================================================================
# Copy this file to .env.local (for local dev) or set these in your hosting
# provider's dashboard (Vercel → Project Settings → Environment Variables).
# NEVER commit .env.local or any file with real values to git.
# ============================================================================

# --- Supabase ---
# Get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# --- Anthropic Claude ---
# Get from https://console.anthropic.com/
# Used by /api/ai/analyze and the flight PDF parser.
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Gmail API (for emailing schedules to staff) ---
# Create OAuth credentials at https://console.cloud.google.com/
# Run `node -r dotenv/config scripts/get-gmail-token.js dotenv_config_path=.env.local`
# after setting CLIENT_ID and CLIENT_SECRET to generate the refresh token.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER=your-sender-email@gmail.com

# --- Gmail Inbox Watcher (optional — enables auto-import via email) ---
# When set, /api/cron/inbox scans the Gmail mailbox above for unread messages
# with attachments and routes them to the right importer (sales, items,
# inventory, flights). Vercel Cron hits it hourly (see vercel.json).
#
# CRON_SECRET: a random string. Vercel auto-attaches this as
#   `Authorization: Bearer $CRON_SECRET` on cron invocations. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# GMAIL_INBOX_ALLOWED_SENDERS (optional): comma-separated email allow-list.
#   Messages from other senders are labelled Failed and ignored. Leave unset
#   to accept any sender the mailbox receives.
CRON_SECRET=generate-a-new-32-byte-hex-string
GMAIL_INBOX_ALLOWED_SENDERS=

# --- Auth (single-user login) ---
# The username/password combo used at /login.
# AUTH_SECRET must be at least 32 characters of random hex.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating AUTH_SECRET instantly invalidates every existing session.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=generate-a-new-32-byte-hex-string
